NODE_ENV=development
PORT=4000

# Local Postgres for now; swapped for a Neon connection string later (docs/decisions.md D-3).
# Port 5433, not 5432 — this is a separate, user-owned cluster (scripts/db-*), not the
# Windows-service PostgreSQL install on 5432. See docs/decisions.md D-7.
DATABASE_URL=postgresql://tessera:tessera_dev_password@localhost:5433/tessera_dev

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=
# Keys the stateless password-reset token to the user's current password_hash —
# see docs/decisions.md D-11. Also generate with the command above.
RESET_SECRET=

# Phase 6 identity/QR — two independent keys (a leaked signing secret alone
# must not let anyone mint a new handle, and vice versa). Also generate with
# the command above.
QR_HANDLE_KEY=
QR_SIGNING_SECRET=
# Shared door-reader key for POST /api/verify (X-Scanner-Key header) — a
# scanner is a device, not a user, so this is checked by requireScannerKey,
# not requireAuth/JWT. Also generate with the command above.
SCANNER_API_KEY=
