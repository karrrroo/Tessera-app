{
  "name": "tessera",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "db:start": "node scripts/db-start.mjs",
    "db:stop": "node scripts/db-stop.mjs",
    "schema:check": "node scripts/schema-check.mjs",
    "data:audit": "node scripts/data-audit.mjs",
    "data:topup": "node scripts/data-topup.mjs",
    "tokens:check": "node scripts/tokens-check.mjs",
    "i18n:check": "tsx scripts/i18n-check.mjs",
    "prestart": "node scripts/guard-no-migrations.mjs && npm run db:start",
    "start": "concurrently -n backend,frontend -c blue,green \"npm run start -w backend\" \"npm run start -w frontend\"",
    "predev": "node scripts/guard-no-migrations.mjs && npm run db:start",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "pg": "^8.13.1",
    "tsx": "^4.19.2"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
