# Backend origin for the /api/* rewrite in next.config.ts. Only needed if the
# backend isn't reachable at the default http://localhost:4000.
BACKEND_INTERNAL_URL=

# Gates the login page's demo-account row (login-view.tsx via
# login/page.tsx) — a server-only check, so its value never reaches the
# browser bundle. Demo and production are the same build (Phase 15 defines
# no separate "demo" environment), so this is the only thing standing
# between a one-tap demo login and a real school's students/staff seeing
# it. MUST be false (or unset) in production.
SHOW_DEMO_CREDENTIALS=false
